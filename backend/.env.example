# Copy to .env and fill in. Password chars must be URL-encoded (@ -> %40).
DATABASE_URL=postgresql://daffodils:PASSWORD@localhost:5432/daffodils?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Media CDN — without these, photo upload paths are disabled in the app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Push notifications
EXPO_ACCESS_TOKEN=

# SMS for OTP and SOS alerts. Unset -> messages are logged, and OTP codes are
# returned in the API response (development only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Face verification provider: `local` (dev only) or `rekognition`.
# See the warning in src/modules/face/face.provider.ts before going live.
FACE_PROVIDER=local
FACE_MATCH_THRESHOLD=0.38

NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
